# docker-compose.yml 용 환경 변수 템플릿
# 사용법: cp .env.example .env  (그 후 .env 값을 채워 사용, .env는 git에 커밋하지 않는다)
#
# 로컬 개발: 아래 기본값 그대로 사용 가능 (SMS_SENDER_PROVIDER=dev → 콘솔에 인증번호 출력)
# 운영 배포: POSTGRES_PASSWORD / REDIS_PASSWORD / SOLAPI_* 등 실제 값으로 반드시 교체

# ---- App ----
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
APP_VERSION=latest

# ---- PostgreSQL ----
POSTGRES_DB=sms_auth
POSTGRES_USER=sms_auth
POSTGRES_PASSWORD=change-me-in-production
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2
# 로컬 디버깅용 호스트 포트 매핑. 운영에서는 docker-compose.yml의 db.ports 자체를 제거 권장.
DB_EXPOSED_PORT=5432

# ---- Redis ----
# 비워두면 무인증(로컬 기본값), 운영에서는 반드시 값 설정
REDIS_PASSWORD=
REDIS_TIMEOUT_MS=3000

# ---- SMS Sender ----
# dev(무료, 콘솔 출력) | mock(무료, 테스트용) | solapi(유료, 실제 발송)
SMS_SENDER_PROVIDER=dev
SMS_FROM_NUMBER=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_BASE_URL=https://api.solapi.com

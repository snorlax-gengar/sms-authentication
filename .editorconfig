root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{java,gradle}]
indent_size = 4
max_line_length = 140

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
indent_size = 2
# Markdown은 줄 끝 공백 2개가 줄바꿈을 의미하므로 제거하지 않는다
trim_trailing_whitespace = false

[*.sql]
indent_size = 4

[Dockerfile]
indent_size = 4

[{gradlew,*.sh}]
end_of_line = lf

[*.bat]
end_of_line = crlf
